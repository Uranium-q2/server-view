# Copy this file to .env and fill in your own values.

# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> Create
# Credentials -> OAuth client ID -> Web application). Add this app's URL
# (e.g. http://localhost:8642 and/or http://YOUR-SERVER-LAN-IP:8642) under
# "Authorized JavaScript origins". No client secret is needed - Server View
# only verifies the ID token Google hands back to the browser.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of Google account emails allowed to log in.
# Anyone who signs in with an account NOT in this list is rejected.
ALLOWED_EMAILS=you@gmail.com

# Optional: used to sign the session cookie. If omitted, Server View
# generates and persists a random one in data/session-secret.txt on first run.
# SESSION_SECRET=
